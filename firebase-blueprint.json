{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "businessName": { "type": "string" },
        "businessType": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "staff", "admin"] },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Document": {
      "title": "Financial Document",
      "description": "Uploaded invoices, receipts, etc.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileSize": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "completed", "error"] },
        "uploadDate": { "type": "string", "format": "date-time" },
        "month": { "type": "string" },
        "year": { "type": "string" },
        "extractedData": {
          "type": "object",
          "properties": {
            "vendorName": { "type": "string" },
            "totalAmount": { "type": "number" },
            "currency": { "type": "string" },
            "taxAmount": { "type": "number" },
            "invoiceNumber": { "type": "string" },
            "category": { "type": "string" }
          }
        }
      },
      "required": ["userId", "fileName", "status", "uploadDate"]
    },
    "Notification": {
      "title": "System Notification",
      "description": "Alerts for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["deadline", "missing_doc", "info", "system", "chat"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "number" },
        "read": { "type": "boolean" },
        "actionUrl": { "type": "string" }
      },
      "required": ["userId", "type", "title", "message", "timestamp", "read"]
    },
    "Report": {
      "title": "Documented Report",
      "description": "Financial reports generated by staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["monthly", "annual", "profit_loss"] },
        "date": { "type": "string", "format": "date-time" },
        "fileUrl": { "type": "string" },
        "period": { "type": "string" }
      },
      "required": ["userId", "title", "type", "date", "fileUrl"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Real-time communication message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "number" },
        "isRead": { "type": "boolean" }
      },
      "required": ["chatId", "senderId", "text", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Main user collection"
    },
    "documents/{docId}": {
      "schema": "Document",
      "description": "Collection of all financial documents"
    },
    "notifications/{notifId}": {
      "schema": "Notification",
      "description": "System-wide and user-specific notifications"
    },
    "reports/{reportId}": {
      "schema": "Report",
      "description": "Financial reports and archives"
    },
    "chats/{chatId}/messages/{msgId}": {
      "schema": "Message",
      "description": "Messages for a specific chat"
    }
  }
}
